{
  "name": "aws-lambda-s3-performance-testing",
  "version": "2.0.0",
  "description": "Enterprise-grade AWS Lambda S3 performance testing suite with LocalStack and K6",
  "main": "lambda/index.js",
  "keywords": ["aws", "lambda", "s3", "performance", "testing", "k6", "localstack"],
  "author": "Enterprise Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node api-gateway-sim.js",
    "deploy": "node scripts/deploy-lambda-s3.js",
    "test": "./run-lambda-s3.sh",
    "test:post": "./scripts/run-k6-tests.sh k6/post-test.js",
    "test:get": "./scripts/run-k6-tests.sh k6/get-test.js",
    "test:both": "npm run test:post && npm run test:get",
    "test:unit": "jest --testMatch=\"**/tests/**/*.test.js\"",
    "test:coverage": "jest --coverage",
    "validate": "npm run lint && npm run test:unit",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "setup": "docker compose -f docker-compose.lambda-s3.yml up -d && npm run deploy",
    "teardown": "docker compose -f docker-compose.lambda-s3.yml down -v",
    "reset": "npm run teardown && npm run setup",
    "clean": "rm -rf reports/* && rm -rf localstack-s3-data/*",
    "health": "curl -f http://localhost:4566/_localstack/health && curl -f http://localhost:3000/health"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/client-lambda": "^3.830.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8"
  },

  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "extends": ["eslint:recommended"],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "no-console": "warn",
      "prefer-const": "error",
      "no-var": "error"
    }
  }
}
